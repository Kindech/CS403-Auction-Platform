FROM golang:1.23-alpine AS build
WORKDIR /src
COPY backend/go.mod backend/go.sum ./
RUN go mod download
COPY backend/ .
RUN CGO_ENABLED=0 go build -o /out/bid-worker ./cmd/bid-worker

FROM alpine:3.20
RUN apk add --no-cache ca-certificates
COPY --from=build /out/bid-worker /usr/local/bin/bid-worker
ENTRYPOINT ["/usr/local/bin/bid-worker"]
